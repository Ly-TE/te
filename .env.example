# ============================================
# Tool Box Front 环境配置文件
# ============================================

# 应用环境设置
ENVIRONMENT=production
DEBUG=False

# 服务器配置
HOST=0.0.0.0
PORT=5000

# 安全配置
SECRET_KEY=your-secret-key-here-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-this-too

# 数据库配置 - 开发环境
DEV_DB_HOST=localhost
DEV_DB_PORT=3306
DEV_DB_USER=root
DEV_DB_PASSWORD=
DEV_DB_NAME=leigod_dev
DEV_DB_CHARSET=utf8mb4

# 数据库配置 - 测试环境
TEST_DB_HOST=your-test-db-host
TEST_DB_PORT=33506
TEST_DB_USER=your-test-db-user
TEST_DB_PASSWORD=your-test-db-password
TEST_DB_CHARSET=utf8mb4

# 数据库配置 - 生产环境
PROD_DB_HOST=your-production-db-host
PROD_DB_PORT=3306
PROD_DB_USER=your-db-user
PROD_DB_PASSWORD=your-db-password
PROD_DB_NAME=leigod_production
PROD_DB_CHARSET=utf8mb4

# 分页配置
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=/var/log/tool_box_front/app.log

# 缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# API配置
API_RATE_LIMIT=100  # 每分钟请求限制
API_TIMEOUT=30      # API超时时间(秒)

# 文件上传配置
MAX_CONTENT_LENGTH=104857600  # 100MB
UPLOAD_FOLDER=/tmp/uploads

# 外部API配置
STAFF_API_BASE_URL=https://vf-staffapi.leigod.com
CLIENT_API_BASE_URL=http://vf-api2.nn.com

# 认证配置
TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_DAYS=7

# 时长配置
DEFAULT_ACTIVITY_DURATION=60  # 默认活动时长(分钟)
MAX_DURATION_LIMIT=1440       # 最大时长限制(分钟)

# 系统配置
MAX_CONNECTIONS=100
WORKER_TIMEOUT=300